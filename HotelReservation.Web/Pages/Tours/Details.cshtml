@page
@model HotelReservation.Web.Pages.Tours.DetailsModel

@{
    ViewData["Title"] = Model.Tour?.Name ?? "Tur Detayları";
}

@if (Model.Tour == null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle me-2"></i>Tur bulunamadı.
    </div>
}
else
{
    var avgRating = Model.GetAverageRating();
    var mainImage = Model.Tour.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath ?? "/uploads/tours/default.jpg";
    var isAvailable = Model.IsAvailable();

    <div class="mb-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Turlara Dön
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <img src="@mainImage" class="card-img-top" style="height: 450px; object-fit: cover; border-radius: 15px 15px 0 0;" alt="@Model.Tour.Name" onerror="this.src='https://via.placeholder.com/800x400?text=Tour'">
                <div class="card-body p-4">
                    <h1 class="card-title fw-bold mb-3">@Model.Tour.Name</h1>
                    <p class="text-muted mb-3 fs-5">
                        <i class="bi bi-geo-alt-fill me-2"></i>@Model.Tour.City
                    </p>
                    @if (avgRating.HasValue)
                    {
                        <div class="mb-4">
                            <span class="badge bg-warning text-dark" style="font-size: 1.1rem; padding: 0.6rem 1rem;">
                                ⭐ @avgRating.Value.ToString("0.0") / 5.0
                            </span>
                            <span class="text-muted ms-2">(@Model.Tour.Reviews?.Count ?? 0 yorum)</span>
                        </div>
                    }
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <strong class="text-muted small d-block mb-2">
                                    <i class="bi bi-calendar-check me-1"></i>Başlangıç Tarihi
                                </strong>
                                <span class="fw-bold">@Model.Tour.StartDate.ToLongDateString()</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <strong class="text-muted small d-block mb-2">
                                    <i class="bi bi-calendar-x me-1"></i>Bitiş Tarihi
                                </strong>
                                <span class="fw-bold">@Model.Tour.EndDate.ToLongDateString()</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <strong class="text-muted small d-block mb-2">
                                    <i class="bi bi-people me-1"></i>Kapasite
                                </strong>
                                <span class="fw-bold">@Model.Tour.CurrentBookings / @Model.Tour.Capacity kişi</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <strong class="text-muted small d-block mb-2">Durum</strong>
                                @if (isAvailable)
                                {
                                    <span class="badge bg-success" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                        <i class="bi bi-check-circle me-1"></i>Müsait
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                        <i class="bi bi-x-circle me-1"></i>Dolu
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Tour.Description))
                    {
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-info-circle me-2"></i>Açıklama
                            </h5>
                            <p class="fs-6">@Model.Tour.Description</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Tour.Itinerary))
                    {
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3">
                                <i class="bi bi-list-check me-2"></i>Tur Programı
                            </h5>
                            <div class="p-3 bg-light rounded-3">
                                <p style="white-space: pre-line; margin-bottom: 0;">@Model.Tour.Itinerary</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.Tour.Reviews != null && Model.Tour.Reviews.Any())
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-0 pb-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-chat-left-text me-2"></i>Yorumlar (@Model.Tour.Reviews.Count)
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        @foreach (var review in Model.Tour.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-4 mb-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="fw-bold mb-1">@review.Customer?.FullName</h6>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar me-1"></i>@review.CreatedAt.ToLocalTime().ToShortDateString()
                                        </small>
                                    </div>
                                    <span class="badge bg-warning text-dark" style="font-size: 1rem;">
                                        @review.Rating ⭐
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <p class="mb-0">@review.Comment</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-chat-left-text" style="font-size: 4rem; color: #dee2e6;"></i>
                        <h5 class="mt-3 text-muted">Henüz yorum yok</h5>
                        <p class="text-muted mb-0">Bu tur için henüz yorum yapılmamış.</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 sticky-top" style="top: 20px; border-radius: 15px;">
                <div class="card-body p-4">
                    <h4 class="card-title fw-bold mb-4">Rezervasyon</h4>
                    <div class="mb-4 text-center">
                        <h2 class="text-primary fw-bold mb-1">@Model.Tour.Price.ToString("C")</h2>
                        <small class="text-muted">Kişi başı</small>
                    </div>
                    @if (isAvailable)
                    {
                        <a asp-page="/TourBookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-primary w-100 btn-lg mb-3">
                            <i class="bi bi-calendar-check me-2"></i>Rezervasyon Yap
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 btn-lg mb-3" disabled>
                            <i class="bi bi-x-circle me-2"></i>Tur Dolu
                        </button>
                    }
                    <hr class="my-4">
                    <div class="small">
                        <div class="mb-3">
                            <strong class="text-muted small d-block mb-1">Tur Yöneticisi</strong>
                            <span>@Model.Tour.Manager?.FullName</span>
                        </div>
                        <div>
                            <strong class="text-muted small d-block mb-1">Oluşturulma</strong>
                            <span>@Model.Tour.CreatedAt.ToLocalTime().ToShortDateString()</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

