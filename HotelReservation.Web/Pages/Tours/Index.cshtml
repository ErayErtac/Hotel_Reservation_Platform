@page
@model HotelReservation.Web.Pages.Tours.IndexModel

@{
    ViewData["Title"] = "Turlar";
}

<style>
    .tours-hero {
        background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 40%, #60d4ff 80%, #fbbf24 100%);
        border-radius: 20px;
        padding: 3rem 2rem;
        margin-bottom: 3rem;
        box-shadow: 0 10px 40px rgba(14, 165, 233, 0.15);
        color: white;
    }
    
    .tours-hero h1 {
        color: white;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .tours-hero p {
        color: rgba(255,255,255,0.9);
        font-size: 1.1rem;
    }
    
    .filter-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        margin-bottom: 3rem;
    }
</style>

<div class="tours-hero">
    <div class="container">
        <h1><i class="bi bi-airplane me-2"></i>Turlar</h1>
        <p>Hayalinizdeki destinasyonlara unutulmaz turlar</p>
    </div>
</div>

<div class="container">
    <form method="get" class="mb-5">
        <div class="filter-card">
            <div class="d-flex align-items-center mb-4">
                <i class="bi bi-funnel me-2 text-primary" style="font-size: 1.5rem;"></i>
                <h4 class="mb-0 fw-bold">Filtrele</h4>
            </div>
            <div class="row g-4">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-geo-alt me-1"></i>Şehir
                    </label>
                    <input type="text" name="city" class="form-control form-control-lg" value="@Model.SearchCity" placeholder="Şehir ara..." />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar-event me-1"></i>Tur Tarihi
                    </label>
                    <input type="date" name="tourDate" class="form-control form-control-lg" value="@(Model.SearchDate?.ToString("yyyy-MM-dd"))" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-search me-2"></i>Ara
                    </button>
                </div>
            </div>
        </div>
    </form>

@if (Model.Tours == null || !Model.Tours.Any())
{
    <div class="text-center py-5">
        <div class="mb-4">
            <i class="bi bi-airplane" style="font-size: 5rem; color: #dee2e6;"></i>
        </div>
        <h3 class="text-muted mb-3">Tur bulunamadı</h3>
        <p class="text-muted">Aradığınız kriterlere uygun tur bulunamadı. Lütfen farklı kriterler deneyin.</p>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Tüm Turlar</h3>
            <p class="text-muted mb-0">@Model.TotalCount tur bulundu</p>
        </div>
    </div>
    
    <div class="row g-4">
        @foreach (var tour in Model.Tours)
        {
            var avgRating = Model.GetAverageRating(tour);
            var mainImage = tour.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath ?? "/uploads/tours/default.jpg";
            var isAvailable = tour.CurrentBookings < tour.Capacity;
            
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm hotel-card">
                    <div class="position-relative">
                        <img src="@mainImage" class="card-img-top hotel-image" alt="@tour.Name" onerror="this.src='https://via.placeholder.com/400x200?text=Tour'">
                        @if (avgRating.HasValue)
                        {
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-warning text-dark" style="font-size: 0.95rem; padding: 0.5rem 0.75rem;">
                                    ⭐ @avgRating.Value.ToString("0.0")
                                </span>
                            </div>
                        }
                        @if (!isAvailable)
                        {
                            <div class="position-absolute top-0 start-0 m-3">
                                <span class="badge bg-danger" style="font-size: 0.9rem;">Dolu</span>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-2">@tour.Name</h5>
                        <p class="text-muted mb-2">
                            <i class="bi bi-geo-alt-fill me-1"></i>@tour.City
                        </p>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar-event me-1"></i>
                            @tour.StartDate.ToString("dd MMM yyyy") - @tour.EndDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-people me-1"></i>@tour.CurrentBookings / @tour.Capacity kişi
                        </p>
                        @if (!string.IsNullOrEmpty(tour.Description))
                        {
                            <p class="card-text small text-muted mb-3 flex-grow-1">
                                @(tour.Description.Length > 100 ? tour.Description.Substring(0, 100) + "..." : tour.Description)
                            </p>
                        }
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-muted small d-block">Kişi Başı</span>
                                    <span class="fw-bold text-primary fs-5">@tour.Price.ToString("C")</span>
                                </div>
                            </div>
                            <a asp-page="./Details" asp-route-id="@tour.Id" class="btn btn-primary w-100">
                                <i class="bi bi-eye me-2"></i>Detayları Gör
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Sayfa navigasyonu" class="mt-5">
            <ul class="pagination justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.CurrentPage - 1)&city=@Model.SearchCity&tourDate=@(Model.SearchDate?.ToString("yyyy-MM-dd"))">
                            <i class="bi bi-chevron-left"></i> Önceki
                        </a>
                    </li>
                }
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&city=@Model.SearchCity&tourDate=@(Model.SearchDate?.ToString("yyyy-MM-dd"))">@i</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.CurrentPage + 1)&city=@Model.SearchCity&tourDate=@(Model.SearchDate?.ToString("yyyy-MM-dd"))">
                            Sonraki <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

