@page
@model HotelReservation.Web.Pages.Hotels.DetailsModel

@{
    ViewData["Title"] = "Otel Detayı";
    var mainImage = Model.Hotel?.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath;
}

@if (Model.Hotel == null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle me-2"></i>Otel bulunamadı.
    </div>
}
else
{
    <div class="mb-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Otel Listesine Dön
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-5">

            @* Ana fotoğraf *@
            @if (!string.IsNullOrEmpty(mainImage))
            {
                <div class="card shadow-sm mb-3 border-0">
                    <img id="mainHotelImage"
                         src="@mainImage"
                         class="card-img-top"
                         style="border-radius: 15px 15px 0 0; height: 350px; object-fit: cover; width: 100%;" />
                </div>
            }

            @* Küçük fotoğraf galerisi *@
            @if (Model.Hotel.Images != null && Model.Hotel.Images.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var img in Model.Hotel.Images)
                    {
                        <img src="@img.ImagePath"
                             onclick="changeMainImage('@img.ImagePath')"
                             class="img-thumbnail"
                             style="
                                 width: 90px;
                                 height: 70px;
                                 object-fit: cover;
                                 border-radius: 10px;
                                 cursor: pointer;
                                 border: @(img.IsMain ? "3px solid #0ea5e9" : "2px solid #dee2e6");
                                 opacity:@(img.IsMain ? "1" : "0.8");
                                 transition: all 0.3s ease;
                             "
                             onmouseover="this.style.opacity='1'; this.style.transform='scale(1.1)'"
                             onmouseout="this.style.opacity='@(img.IsMain ? "1" : "0.8")'; this.style.transform='scale(1)'" />
                    }
                </div>
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h2 class="card-title fw-bold mb-3">@Model.Hotel.Name</h2>
                    <p class="text-muted mb-3">
                        <i class="bi bi-geo-alt-fill me-2"></i>@Model.Hotel.City
                    </p>
                    <div class="mb-3">
                        <strong class="d-block mb-2">
                            <i class="bi bi-geo me-1"></i>Adres:
                        </strong>
                        <p class="text-muted mb-0">@Model.Hotel.Address</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Hotel.Description))
                    {
                        <div class="mb-3">
                            <strong class="d-block mb-2">Açıklama:</strong>
                            <p class="text-muted mb-0">@Model.Hotel.Description</p>
                        </div>
                    }
                    <div class="d-flex align-items-center">
                        <strong class="me-2">Ortalama Puan:</strong>
                        @{
                            var avg = Model.GetAverageRating();
                        }
                        @if (avg.HasValue)
                        {
                            <span class="badge bg-warning text-dark" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                ⭐ @avg.Value.ToString("0.0") / 5
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Henüz yorum yok</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-door-open me-2"></i>Odalar
                </h3>
            </div>

            @if (Model.Hotel.Rooms == null || !Model.Hotel.Rooms.Any())
            {
                <div class="alert alert-info shadow-sm">
                    <i class="bi bi-info-circle me-2"></i>Bu otelde henüz tanımlı oda bulunmuyor.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var room in Model.Hotel.Rooms)
                    {
                        <div class="col-12">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body p-4">
                                    <div class="row align-items-center">
                                        <div class="col-md-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-door-open text-primary me-2" style="font-size: 2rem;"></i>
                                                <div>
                                                    <h5 class="fw-bold mb-0">@room.RoomNumber</h5>
                                                    <small class="text-muted">Oda Numarası</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div>
                                                <strong class="text-muted small d-block">Kapasite</strong>
                                                <span class="fw-bold">
                                                    <i class="bi bi-people me-1"></i>@room.Capacity kişi
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div>
                                                <strong class="text-muted small d-block">Gecelik Fiyat</strong>
                                                <span class="fw-bold text-primary fs-5">@room.PricePerNight.ToString("C")</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            @if (!string.IsNullOrEmpty(room.Description))
                                            {
                                                <div>
                                                    <strong class="text-muted small d-block">Açıklama</strong>
                                                    <p class="mb-0 small">@room.Description</p>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-1">
                                            <a asp-page="/Reservations/Create"
                                               asp-route-roomId="@room.Id"
                                               class="btn btn-primary">
                                                <i class="bi bi-calendar-check me-1"></i>Rezervasyon
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* Yorumlar Bölümü *@
    <div class="row mt-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-chat-left-text me-2"></i>Yorumlar
                    </h3>
                    <p class="text-muted mb-0">@(Model.Hotel.Reviews?.Count ?? 0) yorum</p>
                </div>
                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Customer") || User.IsInRole("HotelManager")))
                {
                    <a asp-page="/Customer/CreateReview" asp-route-hotelId="@Model.Hotel.Id" class="btn btn-primary">
                        <i class="bi bi-chat-left-text me-2"></i>Yorum Yap
                    </a>
                }
            </div>

            @if (Model.Hotel.Reviews == null || !Model.Hotel.Reviews.Any())
            {
                <div class="alert alert-info text-center py-5 shadow-sm">
                    <i class="bi bi-chat-left-text" style="font-size: 4rem; color: #0ea5e9;"></i>
                    <h5 class="alert-heading mt-3">Henüz yorum yok</h5>
                    <p class="mb-0">Bu otel için henüz yorum yapılmamış.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var review in Model.Hotel.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="flex-grow-1">
                                            <h5 class="mb-2 fw-bold">@review.Customer.FullName</h5>
                                            <div class="text-muted small mb-3">
                                                <i class="bi bi-calendar me-1"></i>@review.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                                                @if (review.UpdatedAt.HasValue)
                                                {
                                                    <span class="ms-3">
                                                        <i class="bi bi-pencil me-1"></i>Güncellendi: @review.UpdatedAt.Value.ToString("dd MMMM yyyy HH:mm")
                                                    </span>
                                                }
                                            </div>
                                            <div class="mb-3">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <span class="@(i <= review.Rating ? "text-warning" : "text-muted")" style="font-size: 1.3rem;">⭐</span>
                                                }
                                                <span class="ms-2 fw-semibold fs-5">@review.Rating / 5</span>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <p class="mb-3 fs-6">@review.Comment</p>
                                    }

                                    @if (review.Replies != null && review.Replies.Any())
                                    {
                                        <div class="border-top pt-4 mt-4">
                                            <h6 class="fw-semibold mb-3">
                                                <i class="bi bi-reply me-2"></i>Otel Yöneticisi Yanıtları
                                            </h6>
                                            @foreach (var reply in review.Replies.OrderBy(r => r.CreatedAt))
                                            {
                                                <div class="bg-light p-3 rounded-3 mb-3 border-start border-primary border-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <strong class="d-block">@reply.Manager.FullName</strong>
                                                            <span class="badge bg-primary">Otel Yöneticisi</span>
                                                        </div>
                                                        <small class="text-muted">@reply.CreatedAt.ToString("dd MMMM yyyy HH:mm")</small>
                                                    </div>
                                                    <p class="mb-0">@reply.ReplyText</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @section Scripts {
        <script>
            function changeMainImage(src) {
                var img = document.getElementById('mainHotelImage');
                if (img) {
                    img.src = src;
                }
            }
        </script>
    }
}
