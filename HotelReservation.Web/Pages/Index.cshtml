@page
@model IndexModel
@{
    ViewData["Title"] = "Hotel Reservation Platform";
}

<style>
    :root {
        --primary-color: #0ea5e9;
        --primary-dark: #0284c7;
        --primary-light: #38bdf8;
        --secondary-color: #fb923c;
        --secondary-dark: #f97316;
        --accent-color: #14b8a6;
        --gradient-primary: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 30%, #60d4ff 60%, #fb923c 100%);
        --gradient-soft: linear-gradient(135deg, #38bdf8 0%, #60d4ff 50%, #fb923c 100%);
        --gradient-hero: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 40%, #60d4ff 80%, #fbbf24 100%);
    }
    
    .hero-section {
        background: var(--gradient-hero);
        position: relative;
        overflow: hidden;
        z-index: 1;
        border-radius: 0 0 50px 50px;
    }
    
    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 20% 30%, rgba(255,255,255,0.15) 0%, transparent 60%),
            radial-gradient(circle at 80% 70%, rgba(255,255,255,0.1) 0%, transparent 60%),
            radial-gradient(circle at 50% 50%, rgba(255,255,255,0.05) 0%, transparent 80%);
        opacity: 0.8;
    }
    
    .hero-section::after {
        content: '';
        position: absolute;
        top: -30%;
        right: -5%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        border-radius: 50%;
        animation: float 20s ease-in-out infinite;
    }
    
     @@keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-20px, -20px) rotate(5deg); }
  }
    
    .search-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 60px rgba(14, 165, 233, 0.15), 0 8px 25px rgba(0,0,0,0.08);
        margin-top: 2rem;
        position: relative;
        border: 1px solid rgba(255,255,255,0.5);
        backdrop-filter: blur(20px);
    }
    
    .search-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--gradient-soft);
        border-radius: 24px 24px 0 0;
        opacity: 0.8;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: var(--primary-light);
        box-shadow: 0 0 0 0.2rem rgba(14, 165, 233, 0.12);
    }
    
    .btn-primary {
        background: var(--gradient-soft);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(14, 165, 233, 0.25);
        color: white;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(14, 165, 233, 0.35);
        background: var(--gradient-primary);
        color: white;
    }
    
    .hotel-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
    }
    
    .hotel-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(14, 165, 233, 0.15);
        border-color: var(--primary-light);
    }
    
    .hotel-image {
        height: 200px;
        object-fit: cover;
        width: 100%;
        transition: transform 0.5s ease;
    }
    
    .hotel-card:hover .hotel-image {
        transform: scale(1.08);
    }
    
    .rating-badge {
        background: linear-gradient(135deg, #fb923c 0%, #fbbf24 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(251, 146, 60, 0.25);
    }
    
    .feature-card {
        text-align: center;
        padding: 2.5rem;
        border-radius: 20px;
        transition: all 0.3s ease;
        height: 100%;
        background: white;
        border: 1px solid rgba(0,0,0,0.04);
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }
    
    .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(14, 165, 233, 0.12);
        border-color: var(--primary-light);
    }
    
    .feature-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        background: var(--gradient-soft);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .stat-box {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(15px);
        border-radius: 15px;
        padding: 1.5rem;
        border: 1px solid rgba(255,255,255,0.3);
        transition: all 0.3s ease;
    }
    
    .stat-box:hover {
        background: rgba(255,255,255,0.3);
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }
    
    .search-input-wrapper {
        position: relative;
    }
    
    .search-input-wrapper i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-color);
        z-index: 10;
    }
    
    .search-input-wrapper .form-control,
    .search-input-wrapper .form-select {
        padding-left: 2.5rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchType = document.getElementById('searchType');
        const checkInDiv = document.getElementById('checkInDiv');
        const checkOutDiv = document.getElementById('checkOutDiv');
        const tourDateDiv = document.getElementById('tourDateDiv');
        const guestCountDiv = document.getElementById('guestCountDiv');
        const participantCountDiv = document.getElementById('participantCountDiv');

        searchType.addEventListener('change', function() {
            if (this.value === 'Tour') {
                checkInDiv.style.display = 'none';
                checkOutDiv.style.display = 'none';
                guestCountDiv.style.display = 'none';
                tourDateDiv.style.display = 'block';
                participantCountDiv.style.display = 'block';
            } else {
                checkInDiv.style.display = 'block';
                checkOutDiv.style.display = 'block';
                guestCountDiv.style.display = 'block';
                tourDateDiv.style.display = 'none';
                participantCountDiv.style.display = 'none';
            }
        });
    });
</script>

<div class="hero-section mb-5">
    <div class="container">
        <div class="row align-items-center py-5">
            <div class="col-lg-6 text-white">
                <h1 class="display-4 fw-bold mb-4">Hayalindeki Oteli Bul</h1>
                <p class="lead mb-4">
                    Binlerce otel arasından şehir ve tarih seç, uygun odaları saniyeler içinde görüntüle ve anında rezervasyon yap.
                </p>
                <div class="d-flex gap-3 mb-4 flex-wrap">
                    <div class="stat-box">
                        <h3 class="fw-bold mb-1">500+</h3>
                        <p class="mb-0 small opacity-90">Otel Seçeneği</p>
                    </div>
                    <div class="stat-box">
                        <h3 class="fw-bold mb-1">50+</h3>
                        <p class="mb-0 small opacity-90">Şehir</p>
                    </div>
                    <div class="stat-box">
                        <h3 class="fw-bold mb-1">24/7</h3>
                        <p class="mb-0 small opacity-90">Destek</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="search-card">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-search" style="font-size: 2.5rem; background: var(--gradient-soft); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"></i>
                        </div>
                        <h3 class="fw-bold mb-2">Otel veya Tur Ara</h3>
                        <p class="text-muted mb-0">Hayalinizdeki tatili bulun</p>
                    </div>
                    <form method="get" asp-page="/Search/Index" id="searchForm">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-list-ul me-1 text-primary"></i>Arama Tipi
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-tag"></i>
                                    <select name="SearchType" id="searchType" class="form-select form-select-lg">
                                        <option value="Hotel">🏨 Otel</option>
                                        <option value="Tour">✈️ Tur</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-geo-alt me-1 text-primary"></i>Şehir
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <select name="City" class="form-select form-select-lg">
                                        <option value="">Tüm Şehirler</option>
                                        @foreach (var city in Model.Cities)
                                        {
                                            <option value="@city">@city</option>
                                        }
                                    </select>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    <i class="bi bi-info-circle me-1"></i>Sadece şehir seçerek de arama yapabilirsiniz
                                </small>
                            </div>
                            <div class="col-md-6" id="checkInDiv">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>Giriş Tarihi
                                    <small class="text-muted">(Opsiyonel)</small>
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-calendar3"></i>
                                    <input name="CheckIn" type="date" class="form-control form-control-lg" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="col-md-6" id="checkOutDiv">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-calendar-x me-1 text-primary"></i>Çıkış Tarihi
                                    <small class="text-muted">(Opsiyonel)</small>
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-calendar3"></i>
                                    <input name="CheckOut" type="date" class="form-control form-control-lg" />
                                </div>
                            </div>
                            <div class="col-md-6" id="tourDateDiv" style="display:none;">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Tur Tarihi
                                    <small class="text-muted">(Opsiyonel)</small>
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-calendar3"></i>
                                    <input name="TourDate" type="date" class="form-control form-control-lg" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="col-md-6" id="guestCountDiv">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-people me-1 text-primary"></i>Misafir Sayısı
                                    <small class="text-muted">(Opsiyonel)</small>
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-person"></i>
                                    <input name="GuestCount" type="number" min="1" value="1" class="form-control form-control-lg" placeholder="1" />
                                </div>
                            </div>
                            <div class="col-md-6" id="participantCountDiv" style="display:none;">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-people-fill me-1 text-primary"></i>Katılımcı Sayısı
                                    <small class="text-muted">(Opsiyonel)</small>
                                </label>
                                <div class="search-input-wrapper">
                                    <i class="bi bi-person"></i>
                                    <input name="ParticipantCount" type="number" min="1" value="1" class="form-control form-control-lg" placeholder="1" />
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold" style="font-size: 1.1rem;">
                                    <i class="bi bi-search me-2"></i>Ara
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle me-2" style="font-size: 1.5rem;"></i>
                <div>
                    <h5 class="alert-heading mb-1">Hoş geldiniz!</h5>
                    <p class="mb-0">Rezervasyon yapmak için önce <a asp-page="/Account/Register" class="alert-link fw-bold">kayıt olun</a> veya <a asp-page="/Account/Login" class="alert-link">giriş yapın</a>.</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <ul class="nav nav-tabs" id="featuredTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="hotels-tab" data-bs-toggle="tab" data-bs-target="#hotels" type="button" role="tab">
                    Oteller
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tours-tab" data-bs-toggle="tab" data-bs-target="#tours" type="button" role="tab">
                    Turlar
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="featuredTabsContent">
        <div class="tab-pane fade show active" id="hotels" role="tabpanel">
            @if (Model.FeaturedHotels != null && Model.FeaturedHotels.Any())
            {
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-2">Önerilen Oteller</h2>
                            <p class="text-muted">En yüksek puanlı ve en çok tercih edilen otellerimiz</p>
                        </div>
                        <a asp-page="/Hotels/Index" class="btn btn-outline-primary">Tümünü Gör</a>
                    </div>
            
            <div class="row g-4">
                @foreach (var hotel in Model.FeaturedHotels)
                {
                    var avgRating = Model.GetAverageRating(hotel);
                    var mainImage = hotel.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath ?? "/uploads/hotels/default.jpg";
                    var minPrice = hotel.Rooms != null && hotel.Rooms.Any() ? hotel.Rooms.Min(r => r.PricePerNight) : (decimal?)null;
                    
                    <div class="col-md-6 col-lg-4">
                        <div class="hotel-card card h-100">
                            <div class="position-relative">
                                <img src="@mainImage" class="hotel-image" alt="@hotel.Name" onerror="this.src='https://via.placeholder.com/400x200?text=Hotel'">
                                @if (avgRating.HasValue)
                                {
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="rating-badge">
                                            ⭐ @avgRating.Value.ToString("0.0")
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@hotel.Name</h5>
                                <p class="text-muted mb-2">
                                    <i class="bi bi-geo-alt"></i> @hotel.City
                                </p>
                                @if (!string.IsNullOrEmpty(hotel.Description))
                                {
                                    <p class="card-text small text-muted">
                                        @(hotel.Description.Length > 80 ? hotel.Description.Substring(0, 80) + "..." : hotel.Description)
                                    </p>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    @if (minPrice.HasValue)
                                    {
                                        <div>
                                            <span class="text-muted small">Başlangıç</span>
                                            <div class="fw-bold text-primary">@minPrice.Value.ToString("C")</div>
                                        </div>
                                    }
                                    <a asp-page="/Hotels/Details" asp-route-id="@hotel.Id" class="btn btn-primary btn-sm">
                                        Detaylar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
            }
            else
            {
                <div class="alert alert-info">Henüz önerilen otel bulunmuyor.</div>
            }
        </div>

        <div class="tab-pane fade" id="tours" role="tabpanel">
            @if (Model.FeaturedTours != null && Model.FeaturedTours.Any())
            {
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-2">Önerilen Turlar</h2>
                            <p class="text-muted">Yakın tarihli ve müsait turlarımız</p>
                        </div>
                        <a asp-page="/Tours/Index" class="btn btn-outline-primary">Tümünü Gör</a>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var tour in Model.FeaturedTours)
                        {
                            var avgRating = Model.GetTourAverageRating(tour);
                            var mainImage = tour.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath ?? "/uploads/tours/default.jpg";
                            var isAvailable = tour.CurrentBookings < tour.Capacity;
                            
                            <div class="col-md-6 col-lg-4">
                                <div class="hotel-card card h-100">
                                    <div class="position-relative">
                                        <img src="@mainImage" class="hotel-image" alt="@tour.Name" onerror="this.src='https://via.placeholder.com/400x200?text=Tour'">
                                        @if (avgRating.HasValue)
                                        {
                                            <div class="position-absolute top-0 end-0 m-3">
                                                <span class="rating-badge">
                                                    ⭐ @avgRating.Value.ToString("0.0")
                                                </span>
                                            </div>
                                        }
                                        @if (!isAvailable)
                                        {
                                            <div class="position-absolute top-0 start-0 m-3">
                                                <span class="badge bg-danger">Dolu</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-body">
                                        <h5 class="card-title fw-bold">@tour.Name</h5>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-geo-alt"></i> @tour.City
                                        </p>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-calendar"></i> @tour.StartDate.ToShortDateString() - @tour.EndDate.ToShortDateString()
                                        </p>
                                        @if (!string.IsNullOrEmpty(tour.Description))
                                        {
                                            <p class="card-text small text-muted">
                                                @(tour.Description.Length > 80 ? tour.Description.Substring(0, 80) + "..." : tour.Description)
                                            </p>
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <div>
                                                <span class="text-muted small">Kişi Başı</span>
                                                <div class="fw-bold text-primary">@tour.Price.ToString("C")</div>
                                            </div>
                                            <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">
                                                Detaylar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Henüz önerilen tur bulunmuyor.</div>
            }
        </div>
    </div>

    <div class="mb-5">
        <h2 class="fw-bold mb-4 text-center">Neden Bizi Seçmelisiniz?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card card shadow-sm">
                    <div class="feature-icon">🔒</div>
                    <h5 class="fw-bold">Güvenli Rezervasyon</h5>
                    <p class="text-muted">
                        Onaylı ve güvenilir oteller arasından seçim yaparak içiniz rahat bir şekilde rezervasyon yapabilirsiniz. Tüm işlemleriniz korunur ve güvenli bir ortamda gerçekleşir.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card card shadow-sm">
                    <div class="feature-icon">🏨</div>
                    <h5 class="fw-bold">Otel Yönetimi</h5>
                    <p class="text-muted">
                        Otel sahipleri ve yöneticileri, odalarını ve rezervasyonlarını tek bir yerden rahatlıkla kontrol edebilir. Kullanıcı dostu panel sayesinde yönetim süreci hızlı ve pratik hale gelir.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card card shadow-sm">
                    <div class="feature-icon">⚡</div>
                    <h5 class="fw-bold">Hızlı ve Güvenilir</h5>
                    <p class="text-muted">
                        Aradığınız otele saniyeler içinde ulaşır, işlemlerinizi beklemeden tamamlayabilirsiniz. Sistemimiz her zaman stabil çalışır ve size sorunsuz bir deneyim sunar.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
